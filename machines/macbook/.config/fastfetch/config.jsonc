{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/home/bry/.config/omarchy/branding/logo-small.txt",
    "color": {
      "1": "#6d829d"
    },
    "padding": {
      "top": 2,
      "right": 6,
      "left": 2
    }
  },
  "display": {
    "disableLinewrap": true
  },
  "modules": [
    "break",
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;97;102;107m┌──────────────────────Hardware──────────────────────┐\u001b[0m"
    },
    {
      "type": "host",
      "key": " PC",
      "keyColor": "#9fcbdb"
    },
    {
      "type": "cpu",
      "key": "│ ├",
      "showPeCoreCount": true,
      "keyColor": "#9fcbdb"
    },
    {
      "type": "gpu",
      "key": "│ ├",
      "detectionMethod": "pci",
      "format": "{name}",
      "keyColor": "#9fcbdb"
    },
    {
      "type": "display",
      "key": "│ ├󱄄",
      "keyColor": "#9fcbdb"
    },
    {
      "type": "disk",
      "key": "│ ├󰋊",
      "keyColor": "#9fcbdb"
    },
    {
      "type": "memory",
      "key": "│ ├",
      "keyColor": "#9fcbdb"
    },
    {
      "type": "swap",
      "key": "└ └󰓡 ",
      "keyColor": "#9fcbdb"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;97;102;107m└────────────────────────────────────────────────────┘\u001b[0m"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;97;102;107m┌──────────────────────Software──────────────────────┐\u001b[0m"
    },
    {
      "type": "command",
      "key": " OS",
      "keyColor": "#6d829d",
      "text": "version=$(omarchy-version) && echo \"Omarchy Mx Mac $version\""
    },
    {
      "type": "kernel",
      "key": "│ ├",
      "keyColor": "#6d829d"
    },
    {
      "type": "wm",
      "key": "│ ├",
      "keyColor": "#6d829d"
    },
    {
      "type": "terminal",
      "key": "│ ├",
      "keyColor": "#6d829d"
    },
    {
      "type": "packages",
      "key": "│ ├󰏖",
      "keyColor": "#6d829d"
    },
    {
      "type": "command",
      "key": "│ ├󰸌",
      "keyColor": "#6d829d",
      "text": "theme=$(omarchy-theme-current); echo -e \"$theme \\e[38m●\\e[37m●\\e[36m●\\e[35m●\\e[34m●\\e[33m●\\e[32m●\\e[31m●\""
    },
    {
      "type": "terminalfont",
      "key": "└ └",
      "keyColor": "#6d829d"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;97;102;107m└────────────────────────────────────────────────────┘\u001b[0m"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;97;102;107m┌────────────────Age / Uptime / Update───────────────┐\u001b[0m"
    },
    {
      "type": "command",
      "key": "󱦟 OS Age",
      "keyColor": "#9eabd1",
      "text": "echo $(( ($(date +%s) - $(stat -c %W /)) / 86400 )) days"
    },
    {
      "type": "uptime",
      "key": "󱫐 Uptime",
      "keyColor": "#9eabd1"
    },
    {
      "type": "command",
      "key": " Update",
      "keyColor": "#9eabd1",
      "text": "updated=$(omarchy-version-pkgs); echo \"$updated\""
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;97;102;107m└────────────────────────────────────────────────────┘\u001b[0m"
    },
    "break"
  ]
}
