#!/usr/bin/env python3
"""
omarchy-audio-guard

Protects students from accidental audio playback in classrooms and libraries:
1. Mutes master audio when waking up from system sleep.
2. Mutes master audio when headphones or Bluetooth audio disconnects,
   preventing sound from suddenly blaring through built-in MacBook speakers.
"""

import os
import sys
import subprocess
import threading
import gi

gi.require_version("Gio", "2.0")
gi.require_version("GLib", "2.0")
from gi.repository import Gio, GLib


def mute_speakers(reason: str):
    try:
        # Check current mute status
        res = subprocess.check_output(["pactl", "get-sink-mute", "@DEFAULT_SINK@"], text=True)
        if "yes" in res.lower():
            return  # Already muted

        subprocess.run(["pactl", "set-sink-mute", "@DEFAULT_SINK@", "1"], check=True)
        print(f"[audio-guard] Muted speakers: {reason}", flush=True)

        subprocess.run([
            "notify-send",
            "-u", "low",
            "-a", "Audio Guard",
            "-h", "string:x-canonical-private-synchronous:audio-guard",
            "-i", "audio-volume-muted",
            "Audio Muted",
            f"{reason} — speakers muted for classroom safety"
        ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception as e:
        print(f"[audio-guard] Error muting: {e}", file=sys.stderr, flush=True)


def monitor_system_sleep():
    """Listens for system wake events via logind D-Bus"""
    try:
        bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)

        def on_signal(connection, sender_name, object_path, interface_name, signal_name, parameters):
            if signal_name == "PrepareForSleep":
                going_to_sleep = parameters.unpack()[0]
                if not going_to_sleep:  # False means system just woke up
                    print("[audio-guard] System resumed from sleep", flush=True)
                    mute_speakers("System resumed from sleep")

        bus.signal_subscribe(
            "org.freedesktop.login1",
            "org.freedesktop.login1.Manager",
            "PrepareForSleep",
            "/org/freedesktop/login1",
            None,
            Gio.DBusSignalFlags.NONE,
            on_signal,
            None
        )
    except Exception as e:
        print(f"[audio-guard] Could not subscribe to sleep signals: {e}", file=sys.stderr)


def monitor_pactl_events():
    """Watches pactl subscribe for sink changes (headphone disconnect, fallback to speakers)"""
    try:
        # Get current default sink
        current_sink = subprocess.check_output(["pactl", "get-default-sink"], text=True).strip()

        proc = subprocess.Popen(["pactl", "subscribe"], stdout=subprocess.PIPE, text=True, bufsize=1)
        for line in proc.stdout:
            line = line.strip()
            # If a sink or card or server event occurs
            if "sink" in line or "card" in line or "server" in line:
                try:
                    new_sink = subprocess.check_output(["pactl", "get-default-sink"], text=True).strip()
                    if new_sink != current_sink:
                        print(f"[audio-guard] Default sink changed: {current_sink} -> {new_sink}", flush=True)
                        # If transitioning from headphones / bluez to internal speaker convolver
                        was_headphones = ("headphones" in current_sink.lower() or "bluez" in current_sink.lower())
                        is_speakers = ("convolver" in new_sink.lower() or "speaker" in new_sink.lower())

                        if was_headphones and is_speakers:
                            mute_speakers("Headphones disconnected")

                        current_sink = new_sink
                except Exception:
                    pass
    except Exception as e:
        print(f"[audio-guard] pactl monitor error: {e}", file=sys.stderr)


def main():
    monitor_system_sleep()

    # Run pactl subscriber in background thread
    t = threading.Thread(target=monitor_pactl_events, daemon=True)
    t.start()

    loop = GLib.MainLoop()
    try:
        loop.run()
    except (KeyboardInterrupt, SystemExit):
        pass


if __name__ == "__main__":
    main()
