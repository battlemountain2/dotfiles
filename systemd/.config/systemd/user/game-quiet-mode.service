[Unit]
Description=Noctalia quiet mode for focused fullscreen competitive games
After=graphical-session.target
PartOf=graphical-session.target

[Service]
ExecStart=/usr/bin/python3 /home/bry/.local/bin/game-quiet-mode.py
Restart=on-failure
RestartSec=3
TimeoutStopSec=15

[Install]
WantedBy=graphical-session.target
