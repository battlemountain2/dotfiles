[Unit]
Description=Recover the portrait Noctalia bar after resume or graphics reset
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/home/bry/.local/bin/noctalia-bar-recover --watch
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
