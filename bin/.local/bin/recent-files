#!/usr/bin/env python3
import sys
import os
import subprocess
import json
import time

SHOTS_DIR = os.path.expanduser("~/Pictures/Screenshots")
DOWNLOADS_DIR = os.path.expanduser("~/Downloads")

def format_size(bytes_size):
    for unit in ['B', 'KB', 'MB', 'GB']:
        if bytes_size < 1024.0:
            return f"{bytes_size:.1f} {unit}" if unit != 'B' else f"{int(bytes_size)} B"
        bytes_size /= 1024.0
    return f"{bytes_size:.1f} TB"

def format_time_ago(mtime):
    diff = time.time() - mtime
    if diff < 60:
        return "Just now"
    elif diff < 3600:
        return f"{int(diff // 60)}m ago"
    elif diff < 86400:
        return f"{int(diff // 3600)}h ago"
    elif diff < 172800:
        return "Yesterday"
    else:
        return f"{int(diff // 86400)}d ago"

def list_recent(directory, max_count=10, ext_filter=None):
    if not os.path.isdir(directory):
        return []
    items = []
    try:
        for entry in os.scandir(directory):
            if entry.is_file() and not entry.name.startswith('.'):
                if ext_filter:
                    if not any(entry.name.lower().endswith(ext) for ext in ext_filter):
                        continue
                stat = entry.stat()
                items.append({
                    "path": entry.path,
                    "filename": entry.name,
                    "size": format_size(stat.st_size),
                    "time_ago": format_time_ago(stat.st_mtime),
                    "mtime": stat.st_mtime
                })
    except Exception:
        pass

    items.sort(key=lambda x: x["mtime"], reverse=True)
    return items[:max_count]

def copy_image(path):
    if not os.path.exists(path):
        return
    try:
        with open(path, "rb") as f:
            subprocess.run(["wl-copy", "--type", "image/png"], stdin=f)
        subprocess.run([
            "notify-send", "-a", "Screenshots", "-i", "image",
            "Screenshot Copied to Clipboard", os.path.basename(path), "-t", "2500"
        ])
    except Exception as e:
        subprocess.run(["notify-send", "Copy Failed", str(e)])

def open_file(path):
    if os.path.exists(path):
        subprocess.run(["xdg-open", path])

def copy_path(path):
    if os.path.exists(path):
        subprocess.run(["wl-copy", path])
        subprocess.run([
            "notify-send", "-a", "Files", "-i", "document",
            "Path Copied to Clipboard", path, "-t", "2000"
        ])

def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "shots"
    arg = sys.argv[2] if len(sys.argv) > 2 else ""

    if cmd == "shots":
        print(json.dumps(list_recent(SHOTS_DIR, ext_filter=[".png", ".jpg", ".jpeg", ".webp"])))
    elif cmd == "downloads":
        print(json.dumps(list_recent(DOWNLOADS_DIR)))
    elif cmd == "clips":
        subprocess.run(["/home/bry/.local/bin/clip-tools", "list"])
    elif cmd == "copy-image":
        copy_image(arg)
    elif cmd == "copy-path":
        copy_path(arg)
    elif cmd == "open":
        open_file(arg)

if __name__ == "__main__":
    main()
