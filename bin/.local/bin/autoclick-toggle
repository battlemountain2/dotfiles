#!/usr/bin/env python3
import os
import sys
import time
import signal
import subprocess
from pathlib import Path

PID_FILE = Path("/tmp/autoclicker.pid")
LOG_FILE = Path("/tmp/autoclicker.log")

def notify(title, message, urgency="normal"):
    subprocess.run([
        "notify-send",
        "-a", "Autoclicker",
        "-i", "input-mouse",
        "-u", urgency,
        "-h", "string:synchronous:autoclicker",
        "-t", "2000",
        title,
        message
    ], check=False)

def is_pid_alive(pid: int) -> bool:
    if pid <= 0:
        return False
    try:
        os.kill(pid, 0)
        return True
    except (OSError, ProcessLookupError):
        return False

def run_worker():
    from evdev import UInput, ecodes as e

    cps_str = os.environ.get("AUTOCLICKER_CPS", "30")
    try:
        cps = float(cps_str)
    except ValueError:
        cps = 30.0
    if cps <= 0:
        cps = 30.0

    interval = 1.0 / cps
    down_time = min(0.010, interval * 0.4)
    up_time = max(0.005, interval - down_time)

    def sig_handler(signum, frame):
        sys.exit(0)

    signal.signal(signal.SIGTERM, sig_handler)
    signal.signal(signal.SIGINT, sig_handler)

    try:
        ui = UInput({e.EV_KEY: [e.BTN_LEFT]}, name="hypr-autoclicker")
    except Exception as err:
        with open(LOG_FILE, "a") as f:
            f.write(f"Failed to create UInput: {err}\n")
        sys.exit(1)

    # Allow Wayland/Hyprland to register the virtual device
    time.sleep(0.1)

    try:
        while running:
            ui.write(e.EV_KEY, e.BTN_LEFT, 1)
            ui.syn()
            time.sleep(down_time)
            ui.write(e.EV_KEY, e.BTN_LEFT, 0)
            ui.syn()
            time.sleep(up_time)
    finally:
        try:
            ui.write(e.EV_KEY, e.BTN_LEFT, 0)
            ui.syn()
            ui.close()
        except Exception:
            pass

def toggle():
    if PID_FILE.exists():
        try:
            pid = int(PID_FILE.read_text().strip())
        except ValueError:
            pid = -1

        if is_pid_alive(pid):
            try:
                os.kill(pid, signal.SIGTERM)
            except Exception:
                pass
            try:
                PID_FILE.unlink(missing_ok=True)
            except Exception:
                pass
            notify("Autoclicker: OFF", "Clicking stopped")
            return

        PID_FILE.unlink(missing_ok=True)

    script_path = os.path.abspath(__file__)
    cps_str = os.environ.get("AUTOCLICKER_CPS", "30")
    proc = subprocess.Popen(
        [sys.executable, script_path, "--worker"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True
    )

    PID_FILE.write_text(str(proc.pid))
    notify("Autoclicker: ON", f"Active (~{cps_str} CPS)\nPress Super+Alt+K to stop")

def main():
    if len(sys.argv) > 1 and sys.argv[1] == "--worker":
        run_worker()
    else:
        toggle()

if __name__ == "__main__":
    main()
