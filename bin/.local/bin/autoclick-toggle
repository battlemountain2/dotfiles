#!/usr/bin/env python3
import os
import sys
import time
import signal
import traceback
import subprocess
from pathlib import Path

PID_FILE = Path("/tmp/autoclicker.pid")
LOG_FILE = Path("/tmp/autoclicker.log")

def notify(title, message, urgency="normal"):
    subprocess.run([
        "notify-send",
        "-a", "Autoclicker",
        "-i", "input-mouse",
        "-u", urgency,
        "-h", "string:synchronous:autoclicker",
        "-t", "2000",
        title,
        message
    ], check=False)

def is_pid_alive(pid: int) -> bool:
    if pid <= 0:
        return False
    try:
        os.kill(pid, 0)
        return True
    except (OSError, ProcessLookupError):
        return False

def run_worker():
    running = True

    def sig_handler(signum, frame):
        nonlocal running
        running = False
        sys.exit(0)

    signal.signal(signal.SIGTERM, sig_handler)
    signal.signal(signal.SIGINT, sig_handler)

    try:
        from evdev import UInput, ecodes as e

        cps_str = os.environ.get("AUTOCLICKER_CPS", "25")
        try:
            cps = float(cps_str)
        except ValueError:
            cps = 25.0
        if cps <= 0:
            cps = 25.0

        interval = 1.0 / cps
        # Keep button down long enough (20ms) to pass libinput debounce filter
        down_time = max(0.018, min(0.025, interval * 0.5))
        up_time = max(0.015, interval - down_time)

        cap = {
            e.EV_KEY: [e.BTN_LEFT, e.BTN_RIGHT],
            e.EV_REL: [e.REL_X, e.REL_Y]
        }
        ui = UInput(cap, name="hypr-autoclicker")

        # Give Hyprland & libinput a moment to register the pointer
        time.sleep(0.15)

        try:
            while running:
                ui.write(e.EV_KEY, e.BTN_LEFT, 1)
                ui.syn()
                time.sleep(down_time)
                ui.write(e.EV_KEY, e.BTN_LEFT, 0)
                ui.syn()
                time.sleep(up_time)
        finally:
            try:
                ui.write(e.EV_KEY, e.BTN_LEFT, 0)
                ui.syn()
                ui.close()
            except Exception:
                pass
    except SystemExit:
        pass
    except Exception as err:
        with open(LOG_FILE, "a") as f:
            f.write(f"Worker crashed: {err}\n")
            traceback.print_exc(file=f)
        sys.exit(1)

def toggle():
    if PID_FILE.exists():
        try:
            pid = int(PID_FILE.read_text().strip())
        except ValueError:
            pid = -1

        if is_pid_alive(pid):
            try:
                os.kill(pid, signal.SIGTERM)
            except Exception:
                pass
            try:
                PID_FILE.unlink(missing_ok=True)
            except Exception:
                pass
            notify("Autoclicker: OFF", "Clicking stopped")
            return

        PID_FILE.unlink(missing_ok=True)

    script_path = os.path.abspath(__file__)
    cps_str = os.environ.get("AUTOCLICKER_CPS", "25")
    proc = subprocess.Popen(
        [sys.executable, script_path, "--worker"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True
    )

    PID_FILE.write_text(str(proc.pid))
    notify("Autoclicker: ON", f"Active (~{cps_str} CPS)\nPress Super+Alt+K to stop")

def main():
    if len(sys.argv) > 1 and sys.argv[1] == "--worker":
        run_worker()
    else:
        toggle()

if __name__ == "__main__":
    main()
