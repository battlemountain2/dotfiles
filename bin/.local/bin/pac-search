#!/usr/bin/env python3
import sys
import subprocess
import json
import re

def search_pacman(query):
    query = query.strip()
    if not query:
        return []
    try:
        proc = subprocess.run(
            ['pacman', '-Ss', query],
            text=True, capture_output=True, timeout=3
        )
        lines = proc.stdout.splitlines()
        results = []
        i = 0
        while i < len(lines):
            line = lines[i]
            header_m = re.match(r'^([^\s/]+)/([^\s]+)\s+([^\s]+)(?:\s+\[installed.*\])?', line)
            if header_m:
                repo = header_m.group(1)
                name = header_m.group(2)
                ver = header_m.group(3)
                is_installed = "[installed" in line
                desc = lines[i+1].strip() if (i+1 < len(lines) and lines[i+1].startswith("    ")) else ""
                results.append({
                    "name": name,
                    "repo": repo,
                    "version": ver,
                    "installed": is_installed,
                    "desc": desc
                })
                i += 2
            else:
                i += 1
        return results[:15]
    except Exception:
        return []

if __name__ == '__main__':
    q = sys.argv[1] if len(sys.argv) > 1 else ""
    print(json.dumps(search_pacman(q)))
